package ui



templ Layout(name string, role string, csrf string, content templ.Component) {
 <!DOCTYPE html>
 <html lang="pt-BR">
 <head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="htmx-config" content='{"historyCacheSize":0,"allowEval":false,"includeIndicatorStyles":false}'/>
 <meta name="csrf-token" content={ csrf }/>
 <link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
 <title>Erlaine : Operações aeroportuárias</title>
 <link rel="stylesheet" href="/static/app.css"/>
 <script src="/static/htmx.min.js" defer></script>
 <script src="/static/app.js" defer></script>
 </head>
 <body>
 <aside class="sidebar">
 <a class="brand" href="/">✈ <span>ERLAINE<small>AIRPORT OPERATIONS</small></span></a>
 <p class="nav-label">ESPAÇO DE TRABALHO</p>
 <nav>
 <a href="/?entity=voo">↗ <span>Voos e operações</span></a>
 if role != "passageiro" {
 <a href="/?entity=escala">⇄ <span>Escalas e rotas</span></a>
 <a href="/?entity=bilhete">▤ <span>Bilhetes</span></a>
 <a href="/?entity=passageiro">♙ <span>Passageiros</span></a>
 }
 if role == "passageiro" {
 <a href="/?entity=bilhete">▤ <span>Meus bilhetes</span></a>
 }
 if role == "gerente" {
 <a href="/consultas-avancadas">⌕ <span>Consultas avançadas</span></a>
 <p class="nav-label">CADASTROS</p>
 <a href="/?entity=aeronave">✈ <span>Frota</span></a>
 <a href="/?entity=aeroporto">⌖ <span>Aeroportos</span></a>
 <a href="/?entity=empresa">▦ <span>Empresas</span></a>
 <a href="/?entity=pais">◎ <span>Países</span></a>
 <a href="/?entity=estado">◫ <span>Estados</span></a>
 <a href="/?entity=cidade">⌂ <span>Cidades</span></a>
 }
 </nav>
 <div class="sidebar-bottom"><span class="dot"></span> Operação conectada<small>Perfil: { role }</small></div>
 </aside>
 <div class="workspace">
 <header><span>Centro de operações <span class="muted">/ Gestão aeroportuária</span></span><div class="user"><span class="avatar">E</span>{ name }<form method="post" action="/logout"><input type="hidden" name="csrf" value={ csrf }/><button class="link">Sair ↗</button></form></div></header>
 <main id="main">@content</main>
 <footer>ERLAINE / SISTEMA DE GESTÃO DE AEROPORTO <span>Uma operação. Todos os detalhes.</span></footer>
 </div>
 <div id="modal"></div>
 <div id="toast" role="status" aria-live="polite"></div>
 </body>
 </html>
}
